diff --git a/libs/vkd3d-common/file_utils.c b/libs/vkd3d-common/file_utils.c
index 2eb31fd..4e2f6f7 100644
--- a/libs/vkd3d-common/file_utils.c
+++ b/libs/vkd3d-common/file_utils.c
@@ -64,9 +64,17 @@ bool vkd3d_file_rename_no_replace(const char *from_path, const char *to_path)
     if (!MoveFileA(from_path, to_path))
         code = GetLastError();
     return code == ERROR_SUCCESS;
+#else
+#ifdef __PROSPERO__
+    /* Cache files share a directory/filesystem. link() atomically fails if the
+     * destination exists; never use a check-then-rename race. */
+    if (link(from_path, to_path)) return false;
+    unlink(from_path);
+    return true;
 #else
     return renameat2(AT_FDCWD, from_path, AT_FDCWD, to_path, RENAME_NOREPLACE) == 0;
 #endif
+#endif
 }
 
