 namespace rex::graphics::vulkan {
 
 namespace {
+
+// Opt-in host measurements. Timed regions nest, so these totals must not be
+// added together. No GPU commands, synchronization or guest timing are changed.
+enum class WosCost { kDraw, kPrimitives, kBindings, kResidency, kQueryEnd,
+                     kFenceWait, kPlayback, kQueueSubmit, kCount };
+struct WosFrameCosts {
+  std::array<uint64_t, size_t(WosCost::kCount)> ns{}, calls{};
+  uint64_t last = 0, last_cpu = 0, frames = 0;
+};
+thread_local WosFrameCosts wos_costs;
+struct WosCostScope {
+  WosCost cost;
+  bool enabled = REXCVAR_GET(wos_frame_costs);
+  uint64_t start = 0;
+  explicit WosCostScope(WosCost value) : cost(value) {
+    if (enabled) start = rex::chrono::Clock::QueryHostTickCount();
+  }
+  void Stop() {
+    if (!enabled) return;
+    auto& state = wos_costs;
+    state.ns[size_t(cost)] += rex::chrono::Clock::QueryHostTickCount() - start;
+    ++state.calls[size_t(cost)];
+    enabled = false;
+  }
+  ~WosCostScope() { Stop(); }
+};
+struct WosCostReport {
+  ~WosCostReport() {
+    auto& state = wos_costs;
+    if (!REXCVAR_GET(wos_frame_costs)) { state = {}; return; }
+    const auto now = rex::chrono::Clock::QueryHostTickCount();
+    bool cpu_valid = false;
+    uint64_t cpu = 0;
+#if !REX_PLATFORM_WIN32
+    timespec time{};
+    cpu_valid = clock_gettime(CLOCK_THREAD_CPUTIME_ID, &time) == 0;
+    if (cpu_valid) cpu = uint64_t(time.tv_sec) * 1000000000ull + time.tv_nsec;
+#endif
+    if (!state.last) { state = {}; state.last = now; state.last_cpu = cpu; return; }
+    ++state.frames;
+    if (now - state.last < 2000000000ull) return;
+    const double frames = double(state.frames), scale = 1.0 / (1000000.0 * frames);
+    const auto ms = [&](WosCost cost) { return double(state.ns[size_t(cost)]) * scale; };
+    const auto calls = [&](WosCost cost) { return double(state.calls[size_t(cost)]) / frames; };
+    REXLOG_INFO("WOS coarse perf: {:.2f} swaps/s, {:.2f} ms/frame, graphics-thread CPU {:.2f} ms/frame, "
+                "draws {:.1f}, query ends {:.1f}, queue submits {:.1f}",
+                frames * 1e9 / double(now - state.last), double(now - state.last) * scale,
+                cpu_valid && state.last_cpu && cpu >= state.last_cpu ? double(cpu - state.last_cpu) * scale : -1.0,
+                calls(WosCost::kDraw), calls(WosCost::kQueryEnd), calls(WosCost::kQueueSubmit));
+    REXLOG_INFO("WOS coarse nested ms/frame: draw {:.2f}, primitives {:.2f}, bindings {:.2f}, "
+                "residency {:.2f}, query-end {:.2f}, fence-wait {:.2f}, playback {:.2f}, queue-submit {:.2f}",
+                ms(WosCost::kDraw), ms(WosCost::kPrimitives), ms(WosCost::kBindings),
+                ms(WosCost::kResidency), ms(WosCost::kQueryEnd), ms(WosCost::kFenceWait),
+                ms(WosCost::kPlayback), ms(WosCost::kQueueSubmit));
+    state = {}; state.last = now; state.last_cpu = cpu;
+  }
+};
 
