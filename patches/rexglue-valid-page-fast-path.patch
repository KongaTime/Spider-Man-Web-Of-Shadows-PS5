 namespace rex::graphics {
 
+namespace {
+// RequestRanges can read the PS5 validity bitmap without the global lock.
+// Its storage is fixed between initialization and command-processor shutdown;
+// all published-word accesses must be atomic, including serialized writers.
+uint64_t LoadValidFlags(uint64_t& flags) {
+#if REX_PLATFORM_PS5
+  static_assert(__atomic_always_lock_free(sizeof(uint64_t), nullptr));
+  static_assert(alignof(uint64_t) >= sizeof(uint64_t));
+  return __atomic_load_n(&flags, __ATOMIC_ACQUIRE);
+#else
+  return flags;
+#endif
+}
+
+void StoreValidFlags(uint64_t& flags, uint64_t value) {
+#if REX_PLATFORM_PS5
+  __atomic_store_n(&flags, value, __ATOMIC_RELEASE);
+#else
+  flags = value;
+#endif
+}
+}  // namespace
+
 SharedMemory::SharedMemory(memory::Memory& memory) : memory_(memory) {
   page_size_log2_ = rex::log2_ceil(uint32_t(rex::memory::page_size()));
 }
