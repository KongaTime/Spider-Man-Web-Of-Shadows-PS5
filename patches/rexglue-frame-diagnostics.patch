+// Local Web of Shadows diagnostic patch. Host wall times only, no GPU waits
+// added. Draw phases are mutually exclusive; playback and fence timings may
+// overlap the calling draw/swap phase and must not be added to those totals.
+struct WosDrawPhases {
+  std::array<uint64_t, 11> ns{};
+  uint64_t frames = 0, last_report = 0, playback = 0, fence_wait = 0, submit = 0;
+};
+thread_local WosDrawPhases wos_phases;
+uint64_t WosNow() { return rex::chrono::Clock::QueryHostTickCount(); }
+struct WosDrawScope {
+  uint64_t start = WosNow();
+  size_t phase = 0;
+  void Next(size_t next) {
+    const auto now = WosNow();
+    wos_phases.ns[phase] += now - start;
+    start = now;
+    phase = next;
+  }
+  ~WosDrawScope() { wos_phases.ns[phase] += WosNow() - start; }
+};
+struct WosCallScope {
+  uint64_t& total;
+  uint64_t start = WosNow();
+  ~WosCallScope() { total += WosNow() - start; }
+};
+struct WosSwapReport {
+  ~WosSwapReport() {
+    auto& p = wos_phases;
+    const auto now = WosNow();
+    if (!p.last_report) { p = {}; p.last_report = now; return; }
+    ++p.frames;
+    if (now - p.last_report < 2000000000ull) return;
+    const double scale = 1.0 / (1000000.0 * double(p.frames));
+    REXLOG_INFO("WOS phases ms/frame: analyze {:.2f}, begin {:.2f}, primitives {:.2f}, "
+                "shaders {:.2f}, samplers {:.2f}, textures {:.2f}, targets {:.2f}, "
+                "pipeline {:.2f}, state-bindings {:.2f}, residency {:.2f}, emit {:.2f}; "
+                "nested playback {:.2f}, blocking-fence {:.2f}, queue-submit {:.2f}",
+                p.ns[0]*scale, p.ns[1]*scale, p.ns[2]*scale, p.ns[3]*scale,
+                p.ns[4]*scale, p.ns[5]*scale, p.ns[6]*scale, p.ns[7]*scale,
+                p.ns[8]*scale, p.ns[9]*scale, p.ns[10]*scale,
+                p.playback*scale, p.fence_wait*scale, p.submit*scale);
+    p = {};
+    p.last_report = now;
+  }
+};
