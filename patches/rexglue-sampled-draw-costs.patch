+// Sample whole draws with a per-thread PRNG to avoid always selecting the
+// same periodic draw index. Report raw mean microseconds per sampled draw;
+// extrapolation is approximate and these are host intervals, not GPU time.
+thread_local uint32_t wos_draw_sample_rng = 0x6d2b79f5;
+struct WosSampledDraw {
+  bool selected = false;
+  uint64_t start = 0;
+  size_t phase = 0;
+  WosSampledDraw() {
+    if (!REXCVAR_GET(wos_frame_costs)) return;
+    ++wos_costs.detail_draws;
+    auto& random = wos_draw_sample_rng;
+    random ^= random << 13; random ^= random >> 17; random ^= random << 5;
+    selected = (random & 63) == 0;
+    if (!selected) return;
+    ++wos_costs.sampled_draws;
+    start = rex::chrono::Clock::QueryHostTickCount();
+  }
+  WosSampledDraw(const WosSampledDraw&) = delete;
+  WosSampledDraw& operator=(const WosSampledDraw&) = delete;
+  void Next(size_t next) {
+    if (!selected) return;
+    const auto now = rex::chrono::Clock::QueryHostTickCount();
+    wos_costs.sampled_ns[phase] += now - start;
+    start = now; phase = next;
+  }
+  ~WosSampledDraw() {
+    if (selected) wos_costs.sampled_ns[phase] += rex::chrono::Clock::QueryHostTickCount() - start;
+  }
 };
