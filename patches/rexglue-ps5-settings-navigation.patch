+// Read the physical pad independently of the guest-input capture callback.
+// Otherwise opening an overlay would also neutralize its own navigation.
+void UpdateProsperoGamepad(ImGuiIO& io) {
+  rex::input::X_INPUT_STATE state{};
+  const bool connected = rex::input::prospero::PollPadState(0, &state) == X_ERROR_SUCCESS;
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+  if (connected) io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+  else io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+  const uint16_t buttons = connected ? uint16_t(state.gamepad.buttons) : 0;
+  const auto button = [&](ImGuiKey key, uint16_t mask) {
+    io.AddKeyEvent(key, (buttons & mask) != 0);
+  };
+  using namespace rex::input;
+  button(ImGuiKey_GamepadStart, X_INPUT_GAMEPAD_START);
+  button(ImGuiKey_GamepadBack, X_INPUT_GAMEPAD_BACK);
+  button(ImGuiKey_GamepadFaceDown, X_INPUT_GAMEPAD_A);
+  button(ImGuiKey_GamepadFaceRight, X_INPUT_GAMEPAD_B);
+  button(ImGuiKey_GamepadFaceLeft, X_INPUT_GAMEPAD_X);
+  button(ImGuiKey_GamepadFaceUp, X_INPUT_GAMEPAD_Y);
+  button(ImGuiKey_GamepadDpadLeft, X_INPUT_GAMEPAD_DPAD_LEFT);
+  button(ImGuiKey_GamepadDpadRight, X_INPUT_GAMEPAD_DPAD_RIGHT);
+  button(ImGuiKey_GamepadDpadUp, X_INPUT_GAMEPAD_DPAD_UP);
+  button(ImGuiKey_GamepadDpadDown, X_INPUT_GAMEPAD_DPAD_DOWN);
+  button(ImGuiKey_GamepadL1, X_INPUT_GAMEPAD_LEFT_SHOULDER);
+  button(ImGuiKey_GamepadR1, X_INPUT_GAMEPAD_RIGHT_SHOULDER);
+  const auto analog = [&](ImGuiKey key, float value) {
+    value = connected ? std::clamp(value, 0.0f, 1.0f) : 0.0f;
+    io.AddKeyAnalogEvent(key, value > 0.1f, value);
+  };
+  analog(ImGuiKey_GamepadL2, float(state.gamepad.left_trigger) / 255.0f);
+  analog(ImGuiKey_GamepadR2, float(state.gamepad.right_trigger) / 255.0f);
+  const auto stick = [&](ImGuiKey negative, ImGuiKey positive, int16_t value) {
+    constexpr float deadzone = 8000.0f;
+    analog(negative, (-float(value) - deadzone) / (32768.0f - deadzone));
+    analog(positive, (float(value) - deadzone) / (32767.0f - deadzone));
+  };
+  stick(ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadLStickRight, int16_t(state.gamepad.thumb_lx));
+  stick(ImGuiKey_GamepadLStickDown, ImGuiKey_GamepadLStickUp, int16_t(state.gamepad.thumb_ly));
+  stick(ImGuiKey_GamepadRStickLeft, ImGuiKey_GamepadRStickRight, int16_t(state.gamepad.thumb_rx));
+  stick(ImGuiKey_GamepadRStickDown, ImGuiKey_GamepadRStickUp, int16_t(state.gamepad.thumb_ry));
+}
+}  // namespace
