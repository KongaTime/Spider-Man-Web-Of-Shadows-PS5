+// Compare the actual Vulkan descriptor contents, including the image-view and
+// sampler handles. Shader identities or fetch-constant hashes alone miss
+// texture-streaming changes. The existing descriptor validity bits still gate
+// reuse, so frame/cache resets and allocation failures force fresh writes.
+struct WosTextureDescriptorSnapshot {
+  VkDescriptorSetLayout layout = VK_NULL_HANDLE;
+  uint32_t texture_count = 0, sampler_count = 0;
+  std::vector<VkDescriptorImageInfo> images;
+  bool Matches(VkDescriptorSetLayout new_layout, uint32_t textures, uint32_t samplers,
+               std::span<const VkDescriptorImageInfo> inputs) const {
+    if (layout != new_layout || texture_count != textures || sampler_count != samplers ||
+        images.size() != inputs.size()) return false;
+    for (size_t i = 0; i < inputs.size(); ++i) {
+      if (images[i].imageView != inputs[i].imageView ||
+          images[i].imageLayout != inputs[i].imageLayout ||
+          images[i].sampler != inputs[i].sampler) return false;
+    }
+    return true;
+  }
+  void Store(VkDescriptorSetLayout new_layout, uint32_t textures, uint32_t samplers,
+             std::span<const VkDescriptorImageInfo> inputs) {
+    layout = new_layout; texture_count = textures; sampler_count = samplers;
+    images.assign(inputs.begin(), inputs.end());
+  }
+};
+struct WosTextureDescriptorSnapshots {
+  const VulkanCommandProcessor* owner = nullptr;
+  std::array<WosTextureDescriptorSnapshot, 2> stages;
+};
+thread_local WosTextureDescriptorSnapshots wos_texture_snapshots;
 
