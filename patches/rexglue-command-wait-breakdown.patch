+enum class WosWaitKind { kRing, kPacket, kPollSleep, kCoherency, kCount };
+struct WosCommandWaitCosts {
+  std::array<uint64_t, size_t(WosWaitKind::kCount)> ns{}, calls{};
+  uint64_t ring_cpu = 0, last = 0, frames = 0;
+};
+thread_local WosCommandWaitCosts wos_wait_costs;
+uint64_t WosWaitThreadCpu() {
+#if !REX_PLATFORM_WIN32
+  timespec time{};
+  if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &time) == 0)
+    return uint64_t(time.tv_sec) * 1000000000ull + time.tv_nsec;
+#endif
+  return 0;
+}
+struct WosWaitScope {
+  WosWaitKind kind;
+  bool enabled = REXCVAR_GET(wos_command_wait_costs);
+  uint64_t start = 0, cpu_start = 0;
+  explicit WosWaitScope(WosWaitKind value) : kind(value) {
+    if (!enabled) return;
+    start = rex::chrono::Clock::QueryHostTickCount();
+    if (kind == WosWaitKind::kRing) cpu_start = WosWaitThreadCpu();
+  }
+  ~WosWaitScope() {
+    if (!enabled) return;
+    auto& state = wos_wait_costs;
+    state.ns[size_t(kind)] += rex::chrono::Clock::QueryHostTickCount() - start;
+    ++state.calls[size_t(kind)];
+    if (kind == WosWaitKind::kRing && cpu_start) {
+      const auto cpu = WosWaitThreadCpu();
+      if (cpu >= cpu_start) state.ring_cpu += cpu - cpu_start;
+    }
+  }
+};
+void WosReportCommandWaitCosts() {
+  auto& state = wos_wait_costs;
+  if (!REXCVAR_GET(wos_command_wait_costs)) { state = {}; return; }
+  const auto now = rex::chrono::Clock::QueryHostTickCount();
+  if (!state.last) { state = {}; state.last = now; return; }
+  ++state.frames;
+  if (now - state.last < 2000000000ull) return;
+  const double frames = double(state.frames), scale = 1.0 / (1000000.0 * frames);
+  const auto ms = [&](WosWaitKind kind) { return double(state.ns[size_t(kind)]) * scale; };
+  const auto calls = [&](WosWaitKind kind) { return double(state.calls[size_t(kind)]) / frames; };
+  REXLOG_INFO("WOS command waits ms/frame: ring-empty {:.2f} (CPU {:.2f}), wait-packet {:.2f}, "
+              "nested poll-sleep {:.2f}, nested coherency {:.2f}; calls/frame ring {:.1f}, packets {:.1f}, sleeps {:.1f}, coherency {:.1f}",
+              ms(WosWaitKind::kRing), double(state.ring_cpu) * scale, ms(WosWaitKind::kPacket),
+              ms(WosWaitKind::kPollSleep), ms(WosWaitKind::kCoherency),
+              calls(WosWaitKind::kRing), calls(WosWaitKind::kPacket),
+              calls(WosWaitKind::kPollSleep), calls(WosWaitKind::kCoherency));
+  state = {}; state.last = now;
+}
 
